<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>App Submission Kit</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
<style>
  :root{
    --bg-0:#050506;
    --bg-1:#0b0c0e;
    --glass:rgba(255,255,255,0.055);
    --glass-strong:rgba(255,255,255,0.09);
    --border:rgba(255,255,255,0.14);
    --border-soft:rgba(255,255,255,0.07);
    --ink:#f5f5f7;
    --ink-dim:#98989f;
    --ink-faint:#5c5c62;
    --accent:#eef0f4;
    --danger:#ff6b6b;
    --radius-lg:26px;
    --radius-md:18px;
    --radius-sm:12px;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    min-height:100vh;
    background:
      radial-gradient(circle at 18% 12%, rgba(120,130,160,0.16), transparent 42%),
      radial-gradient(circle at 82% 78%, rgba(90,100,140,0.14), transparent 45%),
      radial-gradient(circle at 50% 100%, rgba(255,255,255,0.05), transparent 60%),
      linear-gradient(180deg, var(--bg-0), var(--bg-1) 60%, #000 100%);
    font-family:-apple-system,BlinkMacSystemFont,"SF Pro Display","SF Pro Text",Inter,"Helvetica Neue",Arial,sans-serif;
    color:var(--ink);
    display:flex;
    justify-content:center;
    padding:56px 18px 90px;
    -webkit-font-smoothing:antialiased;
  }
  .wrap{width:100%;max-width:620px;}

  .eyebrow{
    display:flex;align-items:center;gap:10px;
    font-size:12.5px;letter-spacing:0.14em;text-transform:uppercase;
    color:var(--ink-dim);margin-bottom:14px;font-weight:600;
  }
  .eyebrow .dot{width:6px;height:6px;border-radius:50%;background:linear-gradient(135deg,#fff,#8a8a94);box-shadow:0 0 10px rgba(255,255,255,0.6);}

  h1{
    font-size:34px;line-height:1.12;margin:0 0 8px;font-weight:700;
    letter-spacing:-0.02em;
    background:linear-gradient(180deg,#ffffff, #b9b9c2 130%);
    -webkit-background-clip:text;background-clip:text;color:transparent;
  }
  .sub{color:var(--ink-dim);font-size:15px;line-height:1.5;margin:0 0 34px;max-width:46ch;}

  .panel{
    position:relative;
    background:var(--glass);
    border:1px solid var(--border-soft);
    border-radius:var(--radius-lg);
    padding:26px 24px;
    margin-bottom:18px;
    backdrop-filter:blur(28px) saturate(160%);
    -webkit-backdrop-filter:blur(28px) saturate(160%);
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,0.10),
      0 20px 50px -20px rgba(0,0,0,0.65);
    overflow:hidden;
  }
  .panel::before{
    content:"";position:absolute;inset:0;pointer-events:none;
    background:linear-gradient(135deg, rgba(255,255,255,0.08), transparent 40%);
    opacity:0.7;
  }
  .step-head{
    display:flex;align-items:center;gap:12px;margin-bottom:16px;position:relative;z-index:1;
  }
  .step-num{
    width:26px;height:26px;flex:none;border-radius:9px;
    background:linear-gradient(155deg, rgba(255,255,255,0.22), rgba(255,255,255,0.04));
    border:1px solid var(--border);
    display:flex;align-items:center;justify-content:center;
    font-size:12.5px;font-weight:700;color:var(--ink);
  }
  .step-title{font-size:15.5px;font-weight:600;letter-spacing:-0.01em;}
  .step-title small{display:block;font-weight:400;color:var(--ink-dim);font-size:12.5px;margin-top:2px;}

  label.field-label{
    display:block;font-size:12px;color:var(--ink-dim);margin:0 0 7px;font-weight:600;
    text-transform:uppercase;letter-spacing:0.06em;
  }
  input[type="text"], input[type="password"]{
    width:100%;
    background:rgba(255,255,255,0.045);
    border:1px solid var(--border-soft);
    border-radius:var(--radius-sm);
    padding:13px 14px;
    color:var(--ink);
    font-size:15px;
    outline:none;
    transition:border-color .15s ease, background .15s ease;
    font-family:inherit;
    position:relative;z-index:1;
  }
  input[type="text"]:focus, input[type="password"]:focus{
    border-color:rgba(255,255,255,0.42);
    background:rgba(255,255,255,0.07);
  }
  input::placeholder{color:var(--ink-faint);}
  .field-gap{margin-bottom:14px;}
  .field-gap:last-child{margin-bottom:0;}

  .pw-row{position:relative;}
  .pw-toggle{
    position:absolute;right:10px;top:50%;transform:translateY(-50%);
    background:none;border:none;color:var(--ink-dim);font-size:11.5px;
    cursor:pointer;padding:6px 8px;letter-spacing:0.04em;font-weight:600;
    z-index:2;
  }
  .pw-toggle:hover{color:var(--ink);}

  .upload-row{display:flex;gap:16px;position:relative;z-index:1;}
  .drop{
    flex:1;
    border:1.5px dashed var(--border);
    border-radius:var(--radius-md);
    padding:18px 14px;
    text-align:center;
    cursor:pointer;
    background:rgba(255,255,255,0.02);
    transition:border-color .15s ease, background .15s ease;
    position:relative;
  }
  .drop:hover, .drop.drag{
    border-color:rgba(255,255,255,0.5);
    background:rgba(255,255,255,0.05);
  }
  .drop input{display:none;}
  .drop-icon{font-size:20px;opacity:0.7;margin-bottom:6px;}
  .drop-txt{font-size:12.5px;color:var(--ink-dim);line-height:1.4;}
  .drop-txt b{color:var(--ink);font-weight:600;display:block;font-size:13px;margin-bottom:2px;}

  .preview-square{
    width:100%;aspect-ratio:1/1;border-radius:22%;
    background:repeating-conic-gradient(#1a1a1d 0% 25%, #121214 0% 50%) 50% / 14px 14px;
    overflow:hidden;margin-bottom:10px;
    border:1px solid var(--border-soft);
  }
  .preview-square img{width:100%;height:100%;object-fit:cover;display:block;}
  .preview-wide{
    width:100%;aspect-ratio:1024/500;border-radius:14px;
    background:repeating-conic-gradient(#1a1a1d 0% 25%, #121214 0% 50%) 50% / 14px 14px;
    overflow:hidden;margin-bottom:10px;
    border:1px solid var(--border-soft);
  }
  .preview-wide img{width:100%;height:100%;object-fit:cover;display:block;}

  .dim-tag{
    display:inline-block;font-size:10.5px;color:var(--ink-faint);
    letter-spacing:0.05em;margin-top:2px;
  }
  .check{
    position:absolute;top:8px;right:8px;
    width:20px;height:20px;border-radius:50%;
    background:rgba(20,20,22,0.65);
    border:1px solid rgba(255,255,255,0.35);
    display:flex;align-items:center;justify-content:center;
    font-size:11px;color:#fff;backdrop-filter:blur(4px);
  }

  .crednote{
    font-size:12px;color:var(--ink-faint);line-height:1.5;margin-top:12px;
    padding-top:12px;border-top:1px solid var(--border-soft);position:relative;z-index:1;
  }

  .cta{
    width:100%;
    padding:16px 20px;
    border-radius:20px;
    border:1px solid rgba(255,255,255,0.5);
    background:linear-gradient(180deg, #ffffff, #d9d9de);
    color:#0a0a0b;
    font-size:15.5px;font-weight:700;letter-spacing:-0.01em;
    cursor:pointer;
    display:flex;align-items:center;justify-content:center;gap:10px;
    transition:transform .12s ease, box-shadow .12s ease, opacity .15s ease;
    box-shadow:0 14px 30px -10px rgba(255,255,255,0.25);
    position:relative;
  }
  .cta:hover:not(:disabled){transform:translateY(-1px);}
  .cta:active:not(:disabled){transform:translateY(0px) scale(0.995);}
  .cta:disabled{opacity:0.35;cursor:not-allowed;box-shadow:none;}
  .cta .spin{
    width:15px;height:15px;border-radius:50%;
    border:2px solid rgba(10,10,11,0.25);border-top-color:#0a0a0b;
    animation:spin .7s linear infinite;display:none;
  }
  .cta.loading .spin{display:inline-block;}
  .cta.loading .cta-label{opacity:0.6;}
  @keyframes spin{to{transform:rotate(360deg);}}

  .footnote{
    text-align:center;color:var(--ink-faint);font-size:12px;margin-top:18px;line-height:1.6;
  }
  .status{
    text-align:center;font-size:12.5px;margin-top:12px;min-height:16px;color:var(--ink-dim);
  }
  .status.ok{color:#9fe6b0;}
  .status.err{color:var(--danger);}

  @media (max-width:480px){
    h1{font-size:28px;}
    .upload-row{flex-direction:column;}
  }
</style>
</head>
<body>
<div class="wrap">

  <div class="eyebrow"><span class="dot"></span> App Submission Kit</div>
  <h1>Package your app assets</h1>
  <p class="sub">Enter your app details, drop in your logos, and get a ready-to-submit ZIP — store icon, featured graphic, and a details doc, formatted exactly how it needs to go out.</p>

  <!-- Step 1 & 2 -->
  <div class="panel">
    <div class="step-head">
      <div class="step-num">1</div>
      <div class="step-title">App name<small>Shown on the store listing</small></div>
    </div>
    <div class="field-gap">
      <input type="text" id="appName" placeholder="e.g. WealthPath" />
    </div>
    <div class="step-head" style="margin-top:20px;">
      <div class="step-num">2</div>
      <div class="step-title">Package name<small>Your app's unique identifier</small></div>
    </div>
    <div>
      <input type="text" id="packageName" placeholder="e.g. com.company.appname" />
    </div>
  </div>

  <!-- Step 3 -->
  <div class="panel">
    <div class="step-head">
      <div class="step-num">3</div>
      <div class="step-title">Company logo<small>Auto-fit to a 512 × 512 square store icon</small></div>
    </div>
    <div class="upload-row">
      <div>
        <div class="drop" id="dropSquare">
          <input type="file" id="squareInput" accept="image/*">
          <div class="drop-icon">⬒</div>
          <div class="drop-txt"><b>Upload logo</b>Square or any shape — we'll fit it</div>
        </div>
      </div>
      <div style="flex:1;">
        <div class="preview-square" id="squarePreviewBox"></div>
        <span class="dim-tag" id="squareDim">512 × 512 · Play Store icon</span>
      </div>
    </div>
  </div>

  <!-- Step 4 -->
  <div class="panel">
    <div class="step-head">
      <div class="step-num">4</div>
      <div class="step-title">Featured graphic<small>Resized to 1024 × 500</small></div>
    </div>
    <div class="drop" id="dropWide" style="margin-bottom:12px;">
      <input type="file" id="wideInput" accept="image/*">
      <div class="drop-icon">▭</div>
      <div class="drop-txt"><b>Upload featured banner</b>Any size — it'll be resized to fit</div>
    </div>
    <div class="preview-wide" id="widePreviewBox"></div>
    <span class="dim-tag" id="wideDim">1024 × 500 · Featured graphic</span>
  </div>

  <!-- Step 5 & 6 -->
  <div class="panel">
    <div class="step-head">
      <div class="step-num">5</div>
      <div class="step-title">Login ID<small>Prefilled — edit if needed</small></div>
    </div>
    <div class="field-gap">
      <input type="text" id="loginId" value="QEEPS6707A" />
    </div>
    <div class="step-head" style="margin-top:20px;">
      <div class="step-num">6</div>
      <div class="step-title">Login password<small>Prefilled — edit if needed</small></div>
    </div>
    <div class="pw-row">
      <input type="password" id="loginPw" value="123456" />
      <button type="button" class="pw-toggle" id="pwToggle">SHOW</button>
    </div>
    <div class="crednote">This account is used only to demonstrate the app during review — no transactions or cancellations should be made on it.</div>
  </div>

  <button class="cta" id="downloadBtn" disabled>
    <span class="spin"></span>
    <span class="cta-label">Download submission kit</span>
  </button>
  <div class="status" id="status">Fill in app name, package name, and both logos to continue</div>

  <p class="footnote">The ZIP is named after your app and contains the Play Store icon, the featured graphic, and a details document with your credentials.</p>
  <p class="footnote" style="margin-top:6px;opacity:0.7;">© 2026 Copyright - bishal@advisorkhoj.in</p>
</div>

<script>
const state = { squareBlob:null, wideBlob:null };

const els = {
  appName: document.getElementById('appName'),
  packageName: document.getElementById('packageName'),
  loginId: document.getElementById('loginId'),
  loginPw: document.getElementById('loginPw'),
  pwToggle: document.getElementById('pwToggle'),
  squareInput: document.getElementById('squareInput'),
  wideInput: document.getElementById('wideInput'),
  dropSquare: document.getElementById('dropSquare'),
  dropWide: document.getElementById('dropWide'),
  squarePreviewBox: document.getElementById('squarePreviewBox'),
  widePreviewBox: document.getElementById('widePreviewBox'),
  downloadBtn: document.getElementById('downloadBtn'),
  status: document.getElementById('status'),
};

els.pwToggle.addEventListener('click', () => {
  const showing = els.loginPw.type === 'text';
  els.loginPw.type = showing ? 'password' : 'text';
  els.pwToggle.textContent = showing ? 'SHOW' : 'HIDE';
});

function loadImage(file){
  return new Promise((resolve, reject) => {
    const reader = new FileReader();
    reader.onload = e => {
      const img = new Image();
      img.onload = () => resolve(img);
      img.onerror = reject;
      img.src = e.target.result;
    };
    reader.onerror = reject;
    reader.readAsDataURL(file);
  });
}

// Square store icon: 512x512. If already square, just resize. If not, fit (contain) on a white bg.
function makeSquareLogo(img){
  const size = 512;
  const canvas = document.createElement('canvas');
  canvas.width = size; canvas.height = size;
  const ctx = canvas.getContext('2d');
  if (img.width === img.height){
    ctx.drawImage(img, 0, 0, size, size);
  } else {
    ctx.fillStyle = '#ffffff';
    ctx.fillRect(0, 0, size, size);
    const scale = Math.min(size / img.width, size / img.height);
    const w = img.width * scale, h = img.height * scale;
    const x = (size - w) / 2, y = (size - h) / 2;
    ctx.drawImage(img, x, y, w, h);
  }
  return canvas;
}

// Featured graphic: 1024x500, plain resize/stretch of whatever was uploaded.
function makeFeaturedLogo(img){
  const w = 1024, h = 500;
  const canvas = document.createElement('canvas');
  canvas.width = w; canvas.height = h;
  const ctx = canvas.getContext('2d');
  ctx.drawImage(img, 0, 0, w, h);
  return canvas;
}

function canvasToBlob(canvas){
  return new Promise(resolve => canvas.toBlob(resolve, 'image/png', 1));
}

function setPreview(box, canvas){
  box.innerHTML = '';
  const img = document.createElement('img');
  img.src = canvas.toDataURL('image/png');
  box.appendChild(img);
  const check = document.createElement('div');
  check.className = 'check';
  check.textContent = '✓';
  box.appendChild(check);
}

async function handleSquareFile(file){
  if (!file) return;
  const img = await loadImage(file);
  const canvas = makeSquareLogo(img);
  state.squareBlob = await canvasToBlob(canvas);
  setPreview(els.squarePreviewBox, canvas);
  updateReady();
}

async function handleWideFile(file){
  if (!file) return;
  const img = await loadImage(file);
  const canvas = makeFeaturedLogo(img);
  state.wideBlob = await canvasToBlob(canvas);
  setPreview(els.widePreviewBox, canvas);
  updateReady();
}

els.squareInput.addEventListener('change', e => handleSquareFile(e.target.files[0]));
els.wideInput.addEventListener('change', e => handleWideFile(e.target.files[0]));

[[els.dropSquare, els.squareInput, handleSquareFile], [els.dropWide, els.wideInput, handleWideFile]].forEach(([zone, input, handler]) => {
  zone.addEventListener('click', () => input.click());
  ['dragenter','dragover'].forEach(evt => zone.addEventListener(evt, e => {
    e.preventDefault(); zone.classList.add('drag');
  }));
  ['dragleave','drop'].forEach(evt => zone.addEventListener(evt, e => {
    e.preventDefault(); zone.classList.remove('drag');
  }));
  zone.addEventListener('drop', e => {
    e.preventDefault();
    const file = e.dataTransfer.files[0];
    if (file) handler(file);
  });
});

function updateReady(){
  const ready = els.appName.value.trim() && els.packageName.value.trim() && state.squareBlob && state.wideBlob;
  els.downloadBtn.disabled = !ready;
  if (ready){
    els.status.textContent = 'Ready — your kit is good to go';
    els.status.className = 'status ok';
  } else {
    els.status.textContent = 'Fill in app name, package name, and both logos to continue';
    els.status.className = 'status';
  }
}
[els.appName, els.packageName].forEach(el => el.addEventListener('input', updateReady));

function buildDetailsDoc(){
  const appName = els.appName.value.trim();
  const packageName = els.packageName.value.trim();
  const loginId = els.loginId.value.trim();
  const loginPw = els.loginPw.value.trim();

  return `App Name: ${appName}
Package Name: ${packageName}

App Uploading - DETAILS

- Mutual Fund & Portfolio Management

${appName} is more than just a financial app —it's your gateway to a wealthier future. In a rapidly evolving market, we understand the need for a platform that not only simplifies investment but also empowers users to navigate the complexities of finance. This comprehensive app encapsulates the essence of strategic investing, personalized financial planning, and cutting-edge security—all within a user-friendly interface.

Login Credentials + DECLARATION

${loginId}
${loginPw}

Please don't do any kind of transactions or cancellations as this is a live user account.
`;
}

function safeFileName(name){
  return name.replace(/[\\/:*?"<>|]+/g, '').trim() || 'App';
}

els.downloadBtn.addEventListener('click', async () => {
  if (els.downloadBtn.disabled) return;
  els.downloadBtn.classList.add('loading');
  els.downloadBtn.disabled = true;
  els.status.textContent = 'Packing your ZIP…';
  els.status.className = 'status';

  try{
    const zip = new JSZip();
    zip.file('Play Store Logo.png', state.squareBlob);
    zip.file('Featured Logo.png', state.wideBlob);
    zip.file('App Details.txt', buildDetailsDoc());

    const blob = await zip.generateAsync({ type: 'blob' });
    const appName = safeFileName(els.appName.value.trim());
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `${appName}.zip`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);

    els.status.textContent = `Downloaded ${appName}.zip`;
    els.status.className = 'status ok';
  } catch(err){
    console.error(err);
    els.status.textContent = 'Something went wrong building the ZIP — try again.';
    els.status.className = 'status err';
  } finally {
    els.downloadBtn.classList.remove('loading');
    els.downloadBtn.disabled = false;
  }
});
</script>
</body>
</html>
